{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "index.server.ts",
    "index.client.tsx",
    "shared/**/*.ts",
    "client/**/*.tsx",
    "test/**/*.ts", "types/**/*.d.ts"
  ]
}